# Copied once to /etc/nivesh/nivesh.env (root:nivesh, mode 640). Lives outside the repo; updates never touch it.
# Change a value: sudo nano /etc/nivesh/nivesh.env && sudo systemctl restart nivesh-api
NIVESH_DATA_DIR=/opt/nivesh/data
NIVESH_SCHEDULER=1

# Clerk sign-in (all three are required when sign-in is on)
NIVESH_CLERK_JWKS_URL=https://striking-stingray-9664.clerk.accounts.dev/.well-known/jwks.json
NIVESH_AUTHORIZED_PARTIES=["https://ournivesh.duckdns.org"]
# Approved Clerk user ids (or approve in Clerk with public metadata {"role": "user"})
NIVESH_ALLOWED_USER_IDS=[]

# Users' own Copilot keys. setup.sh fills this with a fresh random key once. Keep a copy somewhere safe:
# losing or changing it makes saved user keys unreadable (users then add them again).
NIVESH_KEYS_MASTER_KEY=

# No server model keys here: with sign-in on, every user runs the Copilot on their own key.
# Telegram/email alert channels are not used with sign-in on (everyone gets the in-app inbox).
