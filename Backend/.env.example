# Copy to Backend/.env (gitignored) or inject via `doppler run -- ...`
# Only the providers referenced in config/llm.yaml need keys.

OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MOONSHOT_API_KEY=

# Optional overrides
# NIVESH_DATA_DIR=D:/nivesh-data
# NIVESH_LLM_CONFIG=config/llm.local.yaml

# Alert delivery (optional). The in-app inbox always works; add channels here.
# NIVESH_TELEGRAM_TOKEN=
# NIVESH_TELEGRAM_CHAT_ID=
# NIVESH_SMTP_HOST=smtp.example.com
# NIVESH_SMTP_PORT=587
# NIVESH_SMTP_USER=
# NIVESH_SMTP_PASSWORD=
# NIVESH_EMAIL_FROM=
# NIVESH_EMAIL_TO=
