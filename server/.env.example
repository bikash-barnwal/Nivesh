# Copy to server/.env (gitignored) or inject via `doppler run -- ...`
# Only the providers referenced in config/llm.yaml need keys.

OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MOONSHOT_API_KEY=

# Optional overrides
# NIVESH_DATA_DIR=D:/nivesh-data
# NIVESH_LLM_CONFIG=config/llm.local.yaml

# Alert delivery (optional). The in-app inbox always works; add channels here.
# NIVESH_TELEGRAM_TOKEN=
# NIVESH_TELEGRAM_CHAT_ID=
# NIVESH_SMTP_HOST=smtp.example.com
# NIVESH_SMTP_PORT=587
# NIVESH_SMTP_USER=
# NIVESH_SMTP_PASSWORD=
# NIVESH_EMAIL_FROM=
# NIVESH_EMAIL_TO=

# Clerk sign-in (leave NIVESH_CLERK_JWKS_URL empty for local dev = no login, one local user who may use the
# server model keys below). With sign-in on, every approved user is equal and uses their own model key.
# JWKS URL: https://<Clerk Frontend API host>/.well-known/jwks.json (Clerk dashboard, API keys page).
# NIVESH_CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Site origin(s) a session token may be issued for. Required when sign-in is on.
# NIVESH_AUTHORIZED_PARTIES=["http://localhost:15001"]
# Approved Clerk user ids. An account can also be approved in Clerk with public metadata {"role": "user"},
# exposed by the session-token claim  "role": "{{user.public_metadata.role}}"  (Clerk dashboard, Sessions).
# NIVESH_ALLOWED_USER_IDS=["user_xxx"]

# Users' own Copilot keys are encrypted with this (32 random bytes, urlsafe base64). Empty = feature off.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing or changing it makes saved user keys unreadable (users add them again).
# NIVESH_KEYS_MASTER_KEY=

# Per-user limits for signed-in users
# NIVESH_USER_COPILOT_PER_DAY=100
# NIVESH_USER_SQL_PER_MINUTE=30
# NIVESH_USER_KEY_TESTS_PER_HOUR=10
